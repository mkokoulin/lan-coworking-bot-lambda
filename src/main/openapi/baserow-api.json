          "dateEnd" : {
            "$ref" : "#/components/schemas/Instant",
            "type" : "string",
            "examples" : [ "2026-12-31T23:59:59Z" ],
            "description" : "Date and time when the tariff expires (ISO-8601, UTC)"
          }
        }
      },
