      "BotRegistrationDto" : {
        "type" : "object",
        "properties" : {
          "event_name" : {
            "type" : "string"
          },
          "date_start" : {
            "$ref" : "#/components/schemas/Instant"
          }
        }
      },
      "CoworkingActiveTariffListItemResponse" : {
        "type" : "object",
        "required" : [ "id", "daysUsed", "dateStart", "dateEnd" ],
        "description" : "Lightweight representation of an active coworking tariff, used in list views",
