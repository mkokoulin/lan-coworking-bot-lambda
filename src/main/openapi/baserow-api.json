  "paths" : {
    "/coworking/v1/active-tariffs" : {
      "get" : {
        "summary" : "List all active coworking tariffs",
        "operationId" : "listCoworkingActiveTariffs",
        "tags" : [ "Coworking Active Tariffs" ],
        "responses" : {
          "200" : {
            "description" : "Active tariffs retrieved successfully",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : { "$ref" : "#/components/schemas/CoworkingActiveTariffListItemResponse" }
                }
              }
            }
          },
          "401" : { "description" : "User is not authenticated" },
          "403" : { "description" : "User does not have permission to access this resource" },
          "500" : { "description" : "Internal server error" }
        },
        "security" : [ { "bearerAuth" : [ ] } ]
      }
    },
    "/coworking/v1/active-tariffs/{externalId}" : {
      "get" : {
        "summary" : "Get an active coworking tariff by its identifier",
        "operationId" : "getCoworkingActiveTariffById",
        "tags" : [ "Coworking Active Tariffs" ],
        "parameters" : [ {
          "description" : "External unique identifier of the active tariff (UUID)",
          "in" : "path",
          "name" : "externalId",
          "required" : true,
          "schema" : { "type" : "string", "format" : "uuid" }
        } ],
        "responses" : {
          "200" : {
            "description" : "Active tariff found and returned successfully",
            "content" : {
              "application/json" : {
                "schema" : { "$ref" : "#/components/schemas/CoworkingActiveTariffResponse" }
              }
            }
          },
          "401" : { "description" : "User is not authenticated" },
          "403" : { "description" : "User does not have permission to access this resource" },
          "404" : { "description" : "Active tariff with the given externalId was not found" },
